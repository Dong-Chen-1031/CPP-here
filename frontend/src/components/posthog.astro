---
// components/PostHog.astro
---

<script>
    import type { PostHog } from "posthog-js";
    import {
        PUBLIC_API_URL,
        PUBLIC_POSTHOG_HOST,
        PUBLIC_POSTHOG_PROJECT_TOKEN,
    } from "astro:env/client";

    // The full bundle is ~218 KB, so it loads once the page has finished
    // loading and the main thread is idle, keeping it off the LCP critical
    // path. Until then window.posthog is a stub that queues capture() calls
    // (the only method the app uses) and replays them after init.
    // If the SDK fails to load, nothing will ever drain the queue, so the
    // stub stops collecting instead of growing for the rest of the session.
    const queued: Parameters<PostHog["capture"]>[] = [];
    let loadFailed = false;
    window.posthog = {
        capture: (...args: Parameters<PostHog["capture"]>) => {
            if (!loadFailed) queued.push(args);
            return undefined;
        },
    } as PostHog;

    async function loadPostHog() {
        const { default: posthog } =
            await import("posthog-js/dist/module.full.no-external");

        // tracing_headers matches exact hostnames, not URLs. An empty
        // PUBLIC_API_URL means the API is same-origin, which resolves to this
        // page's hostname.
        const apiHostname = new URL(PUBLIC_API_URL || "/", location.href)
            .hostname;

        posthog.init(PUBLIC_POSTHOG_PROJECT_TOKEN, {
            api_host: PUBLIC_POSTHOG_HOST,
            defaults: "2026-01-30",
            ui_host: "https://us.posthog.com",
            tracing_headers: [apiHostname, "localhost"],
        });

        // Same class at runtime; the two bundles just ship separate,
        // structurally incompatible type declarations.
        window.posthog = posthog as unknown as PostHog;
        for (const args of queued.splice(0)) posthog.capture(...args);
    }

    // A stale chunk after a deploy, a network error or a blocker can reject
    // the import, and init() can throw.
    function startPostHog() {
        loadPostHog().catch((err: unknown) => {
            console.warn("PostHog failed to load", err);
            loadFailed = true;
            queued.length = 0;
        });
    }

    function whenIdle() {
        if ("requestIdleCallback" in window) {
            requestIdleCallback(startPostHog, { timeout: 3000 });
        } else {
            setTimeout(startPostHog, 0);
        }
    }

    if (document.readyState === "complete") {
        whenIdle();
    } else {
        window.addEventListener("load", whenIdle, { once: true });
    }
</script>
