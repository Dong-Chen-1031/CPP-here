---
import { Button } from "@/components/ui/button";
import { SiGithub } from "@icons-pack/react-simple-icons";
import { CodeIcon } from "@lucide/astro";
import { PUBLIC_GITHUB_LINK } from "astro:env/client";
import { findLocale, LOCALES, localePath } from "@/lib/locales";
import { LanguageMenu } from "@/components/landing/languageMenu";

interface Props {
    lang?: string;
    t?: Record<string, string>;
    /** This page in another language; by default the same path under its prefix. */
    localeHref?: (code: string) => string;
}

const { lang, t } = Astro.props as Props;
const rest = Astro.url.pathname.replace(/^\/[^/]+/, "") || "/";
const { localeHref = (code: string) => localePath(code, rest) } = Astro.props;
const languages = LOCALES.map((l) => ({
    code: l.code,
    name: l.name,
    href: localeHref(l.code),
}));
---

<header class="w-full fixed top-0 h-16 py-4 px-5 border-b-2 border-border flex items-center bg-background/50 backdrop-blur-md z-100">
    <a href={localePath(lang, "/")} class="flex items-center">
        <CodeIcon class="size-5 shrink-0" />
        <p class="ml-2 font-bold text-md tracking-normal hidden min-[25rem]:block">
            C++ Here
        </p>
    </a>

    <div class="flex-1"></div>
    {/* <a
            class="text-sm text-muted-foreground hover:text-primary/80 transition duration-300 hover:duration-150"
            href="#features">Features</a
            > */}
    <!-- <div class="flex-1"></div> -->

    <LanguageMenu
        client:load
        label={t?.language ?? ""}
        current={findLocale(lang).code}
        links={languages}
    />
    <a href={PUBLIC_GITHUB_LINK} target="_blank" rel="noopener noreferrer">
        <Button className="hover:bg-primary/80 flex-1" variant={"outline"}>
            <SiGithub />
            <p class="ml-1">{t?.github}</p>
        </Button>
    </a>
    <a href="/editor">
        <Button className="hover:bg-primary/80 transition ml-3">
            {t?.openEditor}
        </Button>
    </a>
</header>
