---
import Hr from "@/components/landing/hr.astro";
import { FaqAccordion } from "@/components/landing/faq";

interface Props {
    lang?: string;
    t?: Record<string, any>;
}

const { t } = Astro.props as Props;

const faqs: { question: string; answer: string }[] = t?.list ?? [];

// Google stopped showing FAQ rich results in 2026, but Bing and AI search
// still read FAQPage markup.
const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: { "@type": "Answer", text: faq.answer },
    })),
};
---

<section class="px-6 md:px-20 py-24 w-full relative">
    <Hr />
    <div class="max-w-3xl mx-auto text-center mb-16">
        {t?.label && (
            <p class="text-xs uppercase tracking-[0.25em] text-muted-foreground mb-4">
                <span class="mr-1 tracking-widest">//</span>
                {t?.label}
            </p>
        )}
        <h2 class="text-[min(3rem,9vw)] leading-[1.05] font-bold text-balance">
            {t?.heading}
            <br />
            {t?.subheading && (
                <span class="text-muted-foreground">{t?.subheading}</span>
            )}
        </h2>
    </div>

    <FaqAccordion client:load faqs={faqs} />

    <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(faqSchema).replaceAll("<", "\\u003c")}
    ></script>
</section>
