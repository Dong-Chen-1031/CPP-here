---
import Hr from "@/components/landing/hr.astro";
import ExtensionMotion from "@/components/landing/extensionMotion.tsx";
import { buttonVariants } from "@/components/ui/button";
import { blogPath, getAllPosts, postPath, splitId } from "@/lib/blog";
import { DEFAULT_LOCALE, findLocale } from "@/lib/locales";
import { cn } from "@/lib/utils";
import { PuzzleIcon } from "@lucide/astro";
import {
    SiFirefoxbrowser,
    SiGooglechrome,
} from "@icons-pack/react-simple-icons";

interface Props {
    lang?: string;
    t?: Record<string, any>;
}

const { lang, t } = Astro.props as Props;

const posts = (await getAllPosts()).filter(
    (p) => splitId(p).slug === "browser-extension",
);
const post =
    posts.find((p) => splitId(p).locale === findLocale(lang)) ??
    posts.find((p) => splitId(p).locale === DEFAULT_LOCALE);
const learnMoreHref = post ? postPath(post) : blogPath(lang);
---

<section class="px-6 md:px-20 py-24 w-full relative">
    <Hr />
    <div class="max-w-2xl mx-auto text-center mb-30 md:mb-16">
        <p class="text-xs uppercase tracking-[0.25em] text-muted-foreground mb-4">
            <span class="mr-1 tracking-widest">//</span>
            {t?.label}
        </p>
        <h2
            class="text-[min(3rem,6vw)] leading-[1.05] font-bold tracking-tighter text-balance text-muted-foreground align-top"
            data-fit
            data-fit-min="22"
            data-fit-max="48"
            data-fit-vw="8"
        >
            {t?.heading1}
            <br />
            <span class="text-foreground">{t?.heading2}</span>
        </h2>
    </div>
    <div
        class="relative lg:grid lg:grid-cols-2 lg:gap-10 max-[48rem]:flex max-[48rem]:flex-col max-[48rem]:items-center max-[48rem]:justify-center"
        id="extension-relative"
    >
        <ExtensionMotion client:only="react" t={t?.demoDialog} />
        <div
            class="relative lg:flex lg:ml-0 lg:flex-col lg:justify-center mt-6 lg:mt-0 max-[48rem]:pl-0! lg:pl-0! max-w-md md:max-w-2xl md:mx-0"
            id="target"
        >
            <p class="text-xl font-bold">{t?.title}</p>
            <p class="text-muted-foreground mt-2 max-w-xl w-fit">
                {t?.description ||
                    "Import test cases directly from your browser with our extension. Support over 100 competitive programming platforms."}
            </p>
            <div class="flex gap-4 mt-6">
                <a
                    href={learnMoreHref}
                    id="extension-install"
                    class={buttonVariants({ size: "lg" })}
                    hidden
                >
                    <span data-extension-label="chrome" class="contents" hidden>
                        <SiGooglechrome />
                        {t?.addToChrome}
                    </span>
                    <span data-extension-label="edge" class="contents" hidden>
                        <PuzzleIcon />
                        {t?.addToEdge}
                    </span>
                    <span
                        data-extension-label="firefox"
                        class="contents"
                        hidden
                    >
                        <SiFirefoxbrowser />
                        {t?.addToFirefox}
                    </span>
                </a>
                <a
                    href={learnMoreHref}
                    class={buttonVariants({ variant: "outline", size: "lg" })}
                >
                    <span>{t?.learnMore}</span>
                </a>
                <a
                    href={
                        "https://github.com/Dong-Chen-1031/CPP-here/tree/main/extensions"
                    }
                    target="_blank"
                    rel="noopener noreferrer"
                    class={cn(
                        buttonVariants({ variant: "outline", size: "lg" }),
                        "hover:bg-primary/80",
                    )}
                >
                    {t?.sourceCode}
                </a>
            </div>
        </div>
    </div>
</section>

<script>
    import { detectExtensionBrowser, extensionStoreUrl } from "@/lib/extension";

    const link = document.getElementById("extension-install");
    const browser = detectExtensionBrowser();
    const store = extensionStoreUrl(browser);
    if (link instanceof HTMLAnchorElement && browser && store) {
        link.hidden = false;
        link.href = store;
        link.target = "_blank";
        link.rel = "noopener noreferrer";
        for (const label of link.querySelectorAll<HTMLElement>(
            "[data-extension-label]",
        ))
            label.hidden = label.dataset.extensionLabel !== browser;
    }
</script>
