---
import { CodeIcon } from "@lucide/astro";
import { SiGithub } from "@icons-pack/react-simple-icons";
import { PUBLIC_GITHUB_LINK, PUBLIC_STATUS_PAGE } from "astro:env/client";
import { blogPath } from "@/lib/blog";
import { localePath } from "@/lib/locales";

interface Props {
    lang?: string;
    t?: Record<string, any>;
}

const { lang, t } = Astro.props as Props;

const links = [
    { label: t?.editor, href: "/editor" },
    { label: t?.blog, href: blogPath(lang) },
    { label: t?.github, href: PUBLIC_GITHUB_LINK, external: true },
    {
        label: t?.status,
        href: PUBLIC_STATUS_PAGE,
        external: true,
    },
];
---

<footer class="px-6 md:px-20 py-6 sm:py-10 w-full border-t border-foreground/10 text-sm text-muted-foreground">
    <div class="hidden sm:grid grid-cols-3">
        <a class="flex items-center gap-2" href={localePath(lang, "/")}>
            <CodeIcon class="size-4" />
            <span class="font-semibold text-foreground tracking-normal">
                C++ Here
            </span>
            <!-- <span>·</span> -->
            <!-- <a
                class="hover:text-foreground link-fade"
                href={`${PUBLIC_GITHUB_LINK}/blob/main/LICENSE.txt`}
                target="_blank"
                rel="noopener noreferrer"
            >
                {t?.mitLicensed}
            </a> -->
        </a>

        <nav class="flex justify-center items-center gap-5">
            {links.map(({ label, href, external }) => (
                <a
                    href={href}
                    class="hover:text-foreground link-fade"
                    {...(external
                        ? { target: "_blank", rel: "noopener noreferrer" }
                        : {})}
                >
                    {label}
                </a>
            ))}
        </nav>
        <div class="flex justify-end items-center">
            <a
                href={PUBLIC_GITHUB_LINK}
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-foreground link-fade flex items-center gap-1.5"
            >
                <SiGithub className="size-4" />
                <span>{t?.author}</span>
            </a>
        </div>
    </div>

    <div class="flex flex-col items-center gap-5 sm:hidden">
        <a class="flex items-center gap-2" href={localePath(lang, "/")}>
            <CodeIcon class="size-4" />
            <span class="font-semibold text-foreground tracking-normal">
                C++ Here
            </span>
        </a>

        <nav class="flex gap-x-5 gap-y-3 text-center">
            {links.map(({ label, href, external }) => (
                <a
                    href={href}
                    class="hover:text-foreground link-fade"
                    {...(external
                        ? { target: "_blank", rel: "noopener noreferrer" }
                        : {})}
                >
                    {label}
                </a>
            ))}
        </nav>

        <div class="flex items-center gap-1.5">
            <SiGithub className="size-4" />
            <!-- © {new Date().getFullYear()} -->
            <p>{t?.author}</p>
            <!-- · {t?.mitLicensed} -->
        </div>
    </div>
</footer>
