---
import { ZapIcon, FileTextIcon, DatabaseIcon, PlayIcon } from "@lucide/astro";
import Hr from "@/components/landing/hr.astro";
import { PUBLIC_SKIP_API_FETCH } from "astro:env/client";
import { PRIVATE_BUILD_TIME_STATUS_URL } from "astro:env/server";
import { formatStat, type StatFormat } from "@/lib/statsFormat";

interface Props {
    lang?: string;
    t?: Record<string, any>;
}

const { t } = Astro.props as Props;

interface StatusResponse {
    total_count: number;
    total_lines: number;
    total_wasm_size_bytes: number;
    total_duration_seconds: number;
    total_run_count?: number;
}

let apiData: StatusResponse | null = null;
if (!PUBLIC_SKIP_API_FETCH) {
    try {
        console.log(`Fetching stats from ${PRIVATE_BUILD_TIME_STATUS_URL}`);
        const res = await fetch(PRIVATE_BUILD_TIME_STATUS_URL);
        if (res.ok) apiData = await res.json();

        if (!apiData) {
            console.error("API data is null");
            throw new Error("Failed to load stats data");
        }
    } catch (error) {
        console.error(`Error fetching stats from API: ${error}`);
        if (import.meta.env.MODE === "development") {
            console.warn(
                `Failed to fetch stats from API: ${error}\nSkipping API fetch in development mode.`,
            );
            apiData = null;
        } else throw new Error(`Failed to fetch stats from API: ${error}`);
    }
} else {
    console.log("Skipping API fetch for stats due to configuration.");
}

const stats: {
    icon: typeof ZapIcon;
    key: keyof StatusResponse;
    format: StatFormat;
    label: string;
    desc: string;
}[] = [
    {
        icon: ZapIcon,
        key: "total_count",
        format: "count",
        label: t?.compilations,
        desc:
            t?.compilationsDescription ||
            "C++ programs compiled and executed directly in the browser.",
    },
    {
        icon: FileTextIcon,
        key: "total_lines",
        format: "count",
        label: t?.linesCompiled,
        desc:
            t?.lineCompiledDescription ||
            "Lines of C++ code processed through the WebAssembly pipeline.",
    },
    {
        icon: DatabaseIcon,
        key: "total_wasm_size_bytes",
        format: "bytes",
        label: t?.wasmCompiled,
        desc:
            t?.wasmCompiledDescription ||
            "Total size of source code submitted and compiled by users.",
    },
    {
        icon: PlayIcon,
        key: "total_run_count",
        format: "count",
        label: t?.programsRun,
        desc:
            t?.programsRunDescription ||
            "Times a compiled program was run, counting each test case.",
    },
];
---

<section class="px-6 md:px-20 py-24 w-full relative">
    <Hr />
    <div class="max-w-2xl mx-auto text-center mb-16">
        <p class="text-xs uppercase tracking-[0.25em] text-muted-foreground mb-4">
            <span class="mr-1 tracking-widest">//</span>
            {t?.label}
        </p>
        <h2 class="text-[min(3rem,9vw)] leading-[1.05] font-bold tracking-tighter text-balance">
            {t?.heading}
            <br />
            <span class="text-muted-foreground">{t?.subheading}</span>
        </h2>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-px bg-foreground/10 border border-foreground/10 rounded-xl overflow-hidden">
        {stats.map(({ icon: Icon, key, format, label, desc }) => (
            <div class="stat-card group relative bg-background sm:p-8 p-5">
                <div class="relative z-10">
                    <div class="flex items-center justify-center size-10 rounded-md border border-foreground/15 bg-foreground/3 group-hover:border-foreground/30 group-hover:bg-foreground/6 transition-all duration-300 mb-5">
                        <Icon class="size-5 text-foreground/80 group-hover:text-foreground transition-colors" />
                    </div>
                    <p
                        class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tighter tabular-nums"
                        data-stat={key}
                        data-format={format}
                        data-value={apiData?.[key]}
                    >
                        {formatStat(format, apiData?.[key])}
                    </p>
                    <p class="text-sm font-semibold mt-2 tracking-tight">
                        {label}
                    </p>
                    {/* <p class="text-sm leading-relaxed text-muted-foreground mt-1">
                            {desc}
                        </p> */}
                </div>
                <div class="spotlight pointer-events-none absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500" />
            </div>
        ))}
    </div>
</section>

<style>
    .stat-card {
        --mx: 50%;
        --my: 0%;
    }
    .spotlight {
        background: radial-gradient(
            350px circle at var(--mx) var(--my),
            color-mix(in srgb, var(--foreground) 22%, transparent),
            transparent 60%
        );
    }
</style>

<script>
    import { PUBLIC_API_URL } from "astro:env/client";
    import { animate, inView } from "motion";
    import { formatStat, type StatFormat } from "@/lib/statsFormat";

    async function refreshStats() {
        const res = await fetch(`${PUBLIC_API_URL}/api/stats`);
        if (!res.ok) return;
        const totals: Record<string, number | undefined> = await res.json();
        const reduceMotion = matchMedia(
            "(prefers-reduced-motion: reduce)",
        ).matches;
        document.querySelectorAll<HTMLElement>("[data-stat]").forEach((el) => {
            const to = totals[el.dataset.stat!];
            if (typeof to !== "number") return;
            const from = Number(el.dataset.value) || 0;
            const format = el.dataset.format as StatFormat;
            const show = (n: number) =>
                (el.textContent = formatStat(format, n));
            if (reduceMotion || to <= from) return show(to);
            const stop = inView(el, () => {
                stop();
                animate(from, to, {
                    duration: 1.2,
                    ease: "easeOut",
                    onUpdate: show,
                });
            });
        });
    }

    refreshStats().catch((error) =>
        console.warn("Failed to refresh stats:", error),
    );

    class SpotlightStatCard {
        card: HTMLElement;
        currentX = 0;
        currentY = 0;
        targetX = 0;
        targetY = 0;
        hasEntered = false;

        constructor(card: HTMLElement) {
            this.card = card;

            card.addEventListener("pointerenter", (e) => {
                const rect = card.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                this.currentX = this.targetX = x;
                this.currentY = this.targetY = y;
                if (!this.hasEntered) {
                    this.hasEntered = true;
                    requestAnimationFrame(this.animate.bind(this));
                }
            });

            card.addEventListener("pointermove", (e) => {
                const rect = card.getBoundingClientRect();
                this.targetX = e.clientX - rect.left;
                this.targetY = e.clientY - rect.top;
            });
        }

        animate() {
            this.currentX += (this.targetX - this.currentX) * 0.1;
            this.currentY += (this.targetY - this.currentY) * 0.1;
            this.card.style.setProperty("--mx", this.currentX + "px");
            this.card.style.setProperty("--my", this.currentY + "px");
            requestAnimationFrame(this.animate.bind(this));
        }
    }

    document
        .querySelectorAll<HTMLElement>(".stat-card")
        .forEach((card) => new SpotlightStatCard(card));
</script>
