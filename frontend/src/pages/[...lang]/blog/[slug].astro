---
import { render } from "astro:content";
import { ArrowLeftIcon } from "@lucide/astro";
import Layout from "@/layouts/Layout.astro";
import "@/styles/blog.css";
import Header from "@/components/landing/header.astro";
import Footer from "@/components/landing/footer.astro";
import { getTranslation } from "@/lib/langList";
import { jsonLd } from "@/lib/utils";
import {
    blogPath,
    formatDate,
    getAllPosts,
    postPath,
    rssPath,
    splitId,
    type Post,
} from "@/lib/blog";

export async function getStaticPaths() {
    const posts = await getAllPosts();
    return posts.map((post) => {
        const { locale, slug } = splitId(post);
        return {
            params: { lang: locale.path, slug },
            props: {
                post,
                translations: posts.filter((p) => splitId(p).slug === slug),
            },
        };
    });
}

interface Props {
    post: Post;
    translations: Post[];
}

const { lang } = Astro.params;
const { post, translations } = Astro.props;
const { locale, slug } = splitId(post);
const { title, description, pubDate, updatedDate, author, photo } = post.data;

const t = getTranslation(lang);
const { Content } = await render(post);

// Each language this post is written in: for hreflang and the header's menu.
const versions = translations.map((p) => ({
    locale: splitId(p).locale,
    href: postPath(p),
}));
const alternates = [
    ...versions.map((v) => ({ hreflang: v.locale.code, path: v.href })),
    // "/blog/<slug>/" redirects to the visitor's preferred language.
    { hreflang: "x-default", path: `/blog/${slug}/` },
];

const canonical = postPath(post);
const url = new URL(canonical, Astro.site).href;
const ogImage = photo ?? "/og-image.png";
const structuredData = jsonLd({
    "@type": "BlogPosting",
    headline: title,
    description,
    inLanguage: locale.code,
    url,
    mainEntityOfPage: url,
    datePublished: pubDate.toISOString(),
    dateModified: (updatedDate ?? pubDate).toISOString(),
    image: new URL(ogImage, Astro.site).href,
    author: { "@type": "Person", name: author },
    publisher: {
        "@type": "Organization",
        name: "C++ Here",
        url: Astro.site?.href,
        logo: {
            "@type": "ImageObject",
            url: new URL("/favicon-96x96.png", Astro.site).href,
        },
    },
});
---

<Layout
    title={title + t.blog.postTitleSuffix}
    {description}
    lang={locale.code}
    font="inter"
    ogType="article"
    {ogImage}
    ogImageAlt={photo ? title : undefined}
    {canonical}
    alternates={translations.length > 1 ? alternates : []}
>
    <meta
        slot="head"
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    />
    <meta
        slot="head"
        property="article:published_time"
        content={pubDate.toISOString()}
    />
    {updatedDate && (
        <meta
            slot="head"
            property="article:modified_time"
            content={updatedDate.toISOString()}
        />
    )}
    <meta slot="head" property="article:author" content={author} />
    <link
        slot="head"
        rel="alternate"
        type="application/rss+xml"
        title={t.blog.title}
        href={rssPath(lang)}
    />
    <script
        slot="head"
        type="application/ld+json"
        is:inline
        set:html={structuredData}
    ></script>
    <div class="font-jetbrains tabular-nums min-h-dvh flex flex-col">
        <Header
            lang={lang}
            t={t.header}
            localeHref={(code) =>
                versions.find((v) => v.locale.code === code)?.href ??
                blogPath(code)
            }
        />
        <article class="flex-1 mx-auto w-full max-w-[42em] px-5 pt-28 pb-20">
            <a
                href={blogPath(lang)}
                class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground link-fade"
            >
                <ArrowLeftIcon class="size-4" />
                {t.blog.back}
            </a>
            <header class="mt-8">
                <p class="text-sm text-muted-foreground">
                    <time datetime={pubDate.toISOString()}>
                        {formatDate(pubDate, lang)}
                    </time>
                    {updatedDate && (
                        <>
                            {" · "}
                            {t.blog.updated}{" "}
                            <time datetime={updatedDate.toISOString()}>
                                {formatDate(updatedDate, lang)}
                            </time>
                        </>
                    )}
                </p>
                <h1 class="mt-2 text-3xl sm:text-4xl font-bold tracking-tight">
                    {title}
                </h1>
                <p class="mt-3 text-muted-foreground">{description}</p>
            </header>
            <div class="typeset typeset-docs max-w-[42em] mt-10">
                <Content />
            </div>
        </article>
        <Footer lang={lang} t={t.footer} />
    </div>
</Layout>
