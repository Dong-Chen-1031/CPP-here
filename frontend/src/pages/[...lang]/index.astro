---
import Layout from "@/layouts/Layout.astro";
import "@/styles/landing.css";
import Header from "@/components/landing/header.astro";
import Hero from "@/components/landing/hero.astro";
import Features from "@/components/landing/features.astro";
import Extension from "@/components/landing/extension.astro";
import Stats from "@/components/landing/stats.astro";
import CTA from "@/components/landing/CTA.astro";
import Footer from "@/components/landing/footer.astro";

import { getStaticLangPaths, getTranslation } from "@/lib/langList";
import { LOCALES, localePath } from "@/lib/locales";
import Faq from "@/components/landing/faq.astro";

export { getStaticLangPaths as getStaticPaths };

const { lang } = Astro.params;

const t = getTranslation(lang);

const canonical = localePath(lang, "/");
// "/" redirects to the visitor's preferred language, so it's the x-default.
const alternates = [
    ...LOCALES.map((l) => ({
        hreflang: l.code,
        path: localePath(l.code, "/"),
    })),
    { hreflang: "x-default", path: "/" },
];
// console.log(t);
---

{/*
1. header v
2. hero v
3. features v
    (1) C++ to WebAssembly V
    (2) error highlighting V
    (3) test case V
    (4) code formatting V
    (5) i18n V
    (6) built for competitive programming V
    (7) open-source and free to use V
    (8) RWD support V
4. extensions V
5. data V
6. CAT V
7. footer V
*/}
<Layout
    title={t.meta.title}
    description={t.meta.description}
    font="quattro"
    {canonical}
    {alternates}
>
    <meta
        slot="head"
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    />
    <script slot="head" type="application/ld+json" is:inline>
        {
            "@context": "https://schema.org",
            "@type": "SoftwareApplication",
            "name": "C++ Here",
            "url": "https://cpp.doong.me",
            "description": "An open-source, lightweight yet powerful online C++ compiler built for competitive programming.",
            "applicationCategory": "DeveloperApplication",
            "operatingSystem": "Web Browser",
            "offers": {
                "@type": "Offer",
                "price": "0",
                "priceCurrency": "USD"
            },
            "featureList": [
                "C++ to WebAssembly compilation",
                "Error highlighting",
                "Built-in test cases",
                "Code formatting with Clang-format",
                "i18n support",
                "Smart autocomplete",
                "Responsive design — works on any screen and device",
                "Secured by Cloudflare Turnstile and isolated Docker containers",
                "One-click code sharing"
            ],
            "codeRepository": "https://github.com/Dong-Chen-1031/CPP-here",
            "license": "https://github.com/Dong-Chen-1031/CPP-here/blob/main/LICENSE.txt"
        }
    </script>
    <style>
        html,
        body {
            overflow-x: hidden;
            height: 100%;
        }
    </style>
    <div class="font-jetbrains tabular-nums tracking-tight">
        <Header lang={lang} t={t.header} />
        <Hero lang={lang} t={t.hero} />
        <Features lang={lang} t={t.features} />
        <Extension lang={lang} t={t.extension} />
        <Stats lang={lang} t={t.stats} />
        <Faq lang={lang} t={t.faq} />
        <CTA lang={lang} t={t.cta} />
        <Footer lang={lang} t={t.footer} />
    </div>
</Layout>

<script>
    import fitty, { type FittyInstance } from "fitty";

    // Scales each [data-fit] heading so its longest line fills the parent's
    // width, between data-fit-min and data-fit-max (px). Below the minimum the
    // heading wraps instead. data-fit-vw also caps it at that share of the
    // viewport, so short section headings don't outgrow the hero on phones.
    // fitty measures the parent's clientWidth, which includes padding, so
    // every fitted heading sits in a padding-free parent.
    const headings = [...document.querySelectorAll<HTMLElement>("[data-fit]")];
    let fitted: FittyInstance[] = [];
    let fittedWidth = 0;

    // fitty fixes maxSize when it starts, so a new width means new instances.
    function fit() {
        fittedWidth = innerWidth;
        for (const f of fitted) f.unsubscribe();
        fitted = headings.map((el) => {
            const minSize = Number(el.dataset.fitMin);
            let maxSize = Number(el.dataset.fitMax);
            if (el.dataset.fitVw)
                maxSize = Math.min(
                    maxSize,
                    (Number(el.dataset.fitVw) * innerWidth) / 100,
                );
            return fitty(el, { minSize, maxSize: Math.max(minSize, maxSize) });
        });
    }

    fitty.observeWindow = false;
    fit();
    let timer: ReturnType<typeof setTimeout> | undefined;
    addEventListener("resize", () => {
        // Phones fire resize when the URL bar slides; only width matters.
        if (innerWidth === fittedWidth) return;
        clearTimeout(timer);
        timer = setTimeout(fit, 100);
    });
    // The first fit may run with the fallback font; refit once fonts load.
    document.fonts.ready.then(fit);
</script>
