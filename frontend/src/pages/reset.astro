---
import Layout from "@/layouts/Layout.astro";
import { Button } from "@/components/ui/button";
import { getTranslation } from "@/lib/langList";

const t = getTranslation().reset;
---

<Layout title={t.title} noindex={true}>
    <meta
        slot="head"
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    />
    <div class="min-h-screen flex flex-col items-center justify-center gap-4 px-6 text-center">
        <h1 class="text-xl font-medium">{t.heading}</h1>
        <p class="text-sm text-muted-foreground max-w-md">{t.description}</p>
        <Button
            id="reset-button"
            variant="destructive"
            size="lg"
            className="mt-2"
        >
            {t.button}
        </Button>
        <p
            id="reset-status"
            class="text-sm text-muted-foreground"
            data-confirm={t.confirm}
            data-partial-failure={t.partialFailure}
            data-success={t.success}
            hidden
        ></p>
        <div class="flex gap-3 mt-2">
            <a
                href="/"
                class="text-sm underline underline-offset-4 hover:opacity-80 transition-opacity"
            >
                {t.home}
            </a>
            <a
                href="/editor"
                class="text-sm underline underline-offset-4 hover:opacity-80 transition-opacity"
            >
                {t.editor}
            </a>
        </div>
    </div>
</Layout>

<script>
    const button = document.getElementById("reset-button") as HTMLButtonElement;
    const status = document.getElementById("reset-status") as HTMLElement;
    const text = status.dataset as {
        confirm: string;
        partialFailure: string;
        success: string;
    };

    function deleteDatabase(name: string) {
        return new Promise<void>((resolve, reject) => {
            const req = indexedDB.deleteDatabase(name);
            req.onsuccess = () => resolve();
            req.onerror = () => reject(req.error);
            // Another tab still holds the database open; it will be deleted
            // once that tab closes it.
            req.onblocked = () => resolve();
        });
    }

    async function reset() {
        const errors: string[] = [];

        try {
            localStorage.clear();
        } catch (e) {
            errors.push(`localStorage: ${e}`);
        }

        try {
            const dbs = await indexedDB.databases();
            await Promise.all(
                dbs
                    .map((db) => db.name)
                    .filter((name): name is string => !!name)
                    .map(deleteDatabase),
            );
        } catch (e) {
            errors.push(`IndexedDB: ${e}`);
        }

        return errors;
    }

    button.addEventListener("click", async () => {
        if (!confirm(text.confirm)) return;
        button.disabled = true;
        const errors = await reset();
        status.hidden = false;
        if (errors.length) {
            console.error(errors);
            status.textContent = text.partialFailure.replace(
                "{{errors}}",
                errors.join("; "),
            );
            button.disabled = false;
        } else {
            status.textContent = text.success;
        }
    });
</script>
