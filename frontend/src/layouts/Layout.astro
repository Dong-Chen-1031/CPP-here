---
import { Font } from "astro:assets";
import "@/styles/global.css";
import PostHog from "@/components/posthog.astro";

interface Props {
    title?: string;
    description?: string;
    ogImage?: string;
    ogImageAlt?: string;
    noindex?: boolean;
    lang?: string;
    /** The family the page is mostly set in, preloaded so its text renders sooner. */
    font?: "jetbrains" | "quattro";
    /** Path of the URL search engines should index, when it isn't this one. */
    canonical?: string;
    /** Every language version of this page (itself included), as hreflang links. */
    alternates?: { hreflang: string; path: string }[];
}

const {
    title = "Online C++ Compiler for Competitive Programming | C++ Here",
    description = "Free, open-source online C++ compiler built for competitive programming. Compile C++ to WebAssembly and run test cases in your browser. No install, no login.",
    ogImage = "/og-image.png",
    ogImageAlt = "C++ Here — next-generation online C++ editor for competitive programming",
    noindex = false,
    lang,
    font = "jetbrains",
    canonical,
    alternates = [],
} = Astro.props;

const siteUrl = "https://cpp.doong.me";
const canonicalURL = new URL(canonical ?? Astro.url.pathname, siteUrl).href;
const ogImageURL = ogImage.startsWith("http")
    ? ogImage
    : `${siteUrl}${ogImage}`;

// The locale lives in the route (`/zh-tw/...`), not in an Astro i18n config, so
// derive it from the path instead of hardcoding "en" on every page. Pages whose
// language is chosen client-side (the editor) get corrected by lib/i18n.ts.
const LOCALES: Record<string, string> = { en: "en", "zh-tw": "zh-TW" };
const localeSegment =
    Astro.url.pathname.split("/").filter(Boolean)[0]?.toLowerCase() ?? "";
const htmlLang = lang ?? LOCALES[localeSegment] ?? Astro.currentLocale ?? "en";
const ogLocale = htmlLang === "zh-TW" ? "zh_TW" : "en_US";
---

<!doctype html>
<html class="neutral dark bg-background text-foreground" lang={htmlLang}>
    <head>
        <meta charset="UTF-8" />
        <Font
            cssVariable="--font-jetbrains-mono"
            preload={
                font === "jetbrains" && [{ style: "normal", subset: "latin" }]
            }
        />
        <Font
            cssVariable="--font-ia-writer-quattro"
            preload={font === "quattro" && [{ style: "normal" }]}
        />

        <slot name="head" />

        <link
            rel="icon"
            type="image/png"
            href="/favicon-96x96.png"
            sizes="96x96"
        />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="shortcut icon" href="/favicon.ico" />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/apple-touch-icon.png"
        />
        <meta name="apple-mobile-web-app-title" content="C++ Here" />
        <link rel="manifest" href="/site.webmanifest" />
        <meta name="generator" content={Astro.generator} />

        {/* Primary SEO */}
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalURL} />
        {alternates.map(({ hreflang, path }) => (
            <link
                rel="alternate"
                hreflang={hreflang}
                href={new URL(path, siteUrl).href}
            />
        ))}
        {noindex && <meta name="robots" content="noindex,nofollow" />}

        {/* Discord / Social theme color */}
        <meta name="theme-color" content="#0A0A0A" />

        {/* Open Graph */}
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImageURL} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={ogImageAlt} />
        <meta property="og:site_name" content="C++ Here" />
        <meta property="og:locale" content={ogLocale} />

        {/* Twitter Card */}
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImageURL} />
        <meta name="twitter:image:alt" content={ogImageAlt} />

        {/* PostHog analytics */}
        <PostHog />

        {/* <script is:inline>
      const getThemePreference = () => {
        if (
          typeof localStorage !== "undefined" &&
          localStorage.getItem("theme")
