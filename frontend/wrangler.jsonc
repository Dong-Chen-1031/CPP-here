{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "cpp-here",
    "compatibility_date": "2026-06-19",
    "compatibility_flags": ["nodejs_compat"],
    "routes": [
        {
            "pattern": "cpp.doong.me",
            "zone_name": "doong.me",
            "custom_domain": true,
        },
    ],
    // Astro's Cloudflare adapter binds sessions to `SESSION`; without the id here
    // `wrangler deploy` drops it from the remote config and only inherits it.
    "kv_namespaces": [
        {
            "binding": "SESSION",
            "id": "00418d0d89144e979ab8cd851db8eb8e",
        },
    ],
    "r2_buckets": [
        {
            "binding": "R2_BUCKET",
            "bucket_name": "cpp-here",
        },
    ],
    // Everything instance-specific lives in Cloudflare, not in this public repo. Both sets
    // are documented with their defaults in frontend/.env.example:
    //   - The PRIVATE_* secrets (JWT_SECRET, TURNSTILE_SECRET_KEY, TURNSTILE_CHECK_IP,
    //     TEST_JWT, BUILDER_NODE_ENDPOINT, BUILDER_NODE_KEY, JWT_EXPIRATION_SECONDS) are read
    //     at request time: `wrangler secret put` each one, and secrets survive deploys.
    //   - The PUBLIC_* values are inlined into the client bundle by `astro build`, so they
    //     belong in the Workers Builds build variables, not in the Worker's vars. Changing
    //     one in the dashboard does nothing until the next build.
    // `keep_vars` stops `wrangler deploy` from deleting vars set in the dashboard.
    "keep_vars": true,
    "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "logs": {
            "enabled": true,
            "head_sampling_rate": 1,
            "destinations": ["posthog-logs"],
            "persist": true,
            "invocation_logs": true,
        },
        "traces": {
            "enabled": true,
            "persist": true,
            "head_sampling_rate": 1,
            "destinations": ["posthog"],
        },
    },
}
