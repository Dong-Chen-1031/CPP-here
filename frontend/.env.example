# Copy this file to frontend/.env. Every variable is optional; the commented value is the
# default unless the comment says otherwise, so an uncommented line means "changed on purpose".
# The schema is defined in frontend/astro.config.mjs.
#
# There are two ways to run the frontend, and they read different halves of this file:
#   - Cloudflare Worker (`bun run build` / `bun run deploy`): /api/verify, /api/share and
#     /api/build are served by the frontend itself. /api/build is proxied to
#     PRIVATE_BUILDER_NODE_ENDPOINT, and shares go to the R2_BUCKET binding in wrangler.jsonc.
#   - Static site (`bun run build:static`, used by the Docker image): there are no server
#     routes, so the PRIVATE_* values below are ignored - except
#     PRIVATE_BUILD_TIME_STATUS_URL, which is read while prerendering, before the server
#     routes are dropped - and PUBLIC_API_URL must point at the Python backend, which
#     implements the same /api/* endpoints.
# Last synced 2026-09-22 at commit 4728ba4


# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------

# Base URL the browser uses for /api/verify, /api/build and /api/share. Leave empty to call
# the frontend's own server routes (Cloudflare Worker). For a static build, set it to the
# backend's public URL, e.g. "http://localhost:8000"; that backend's FRONTEND_URL must match
# the URL you open this frontend at, or CORS blocks every request.
# Scope: build-time (inlined into the client bundle; a rebuild is needed to change it)
# Default: "" (same origin)
# PUBLIC_API_URL=""

# Skip the landing-page stats fetch during the build. Turn it off only when the backend is
# reachable at build time; otherwise the build fails or stalls waiting for it.
# Scope: build-time (the fetch happens while prerendering)
# Default: true
# PUBLIC_SKIP_API_FETCH="true"

# Full URL of the backend status endpoint the landing page reads its stats from at build
# time. Fetched exactly as written, so the path is part of the value; it must match the
# backend's own route (its /api/status). Inside Docker this is a build-network address
# such as "http://backend:8000/api/status", not the browser URL.
# Ignored when PUBLIC_SKIP_API_FETCH is "true".
# Scope: build-time (prerender only; inlined server-side, never reaches the browser)
# Default: "http://127.0.0.1:8000/api/status"
# PRIVATE_BUILD_TIME_STATUS_URL="http://127.0.0.1:8000/api/status"

# Backend the frontend's own /api/build route proxies to.
# Scope: runtime (server route only; ignored by a static build)
# Default: "http://127.0.0.1:8000"
# PRIVATE_BUILDER_NODE_ENDPOINT="http://127.0.0.1:8000"

# Bearer token the /api/build proxy sends to the builder node. The user's own token stops at
# the frontend middleware, so the node authenticates the frontend itself with this shared key.
# Must equal the backend's CAPTCHA_TEST_TOKEN, or the backend needs BYPASS_CAPTCHA="true".
# Generate one with: openssl rand -base64 32
# Scope: runtime (server route only; ignored by a static build)
# Default: "" (the builder node rejects the proxied request)
# PRIVATE_BUILDER_NODE_KEY=""


# ---------------------------------------------------------------------------
# Verification (Turnstile / JWT)
# ---------------------------------------------------------------------------

# Cloudflare Turnstile site key rendered in the browser widget. Must pair with the secret key
# of whoever verifies the token: PRIVATE_TURNSTILE_SECRET_KEY on the Worker, or the Python
# backend's TURNSTILE_SECRET when PUBLIC_API_URL points there. All three default to
# Cloudflare's matching test pair, so replace every one of them for production.
# Scope: build-time (inlined into the client bundle)
# Default: "1x00000000000000000000BB" (Cloudflare's always-pass test key)
# PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000BB"

# Skip Turnstile and token checks entirely. For local development only — it disables the
# middleware's token check as well. When requests go to the Python backend, that backend
# also needs BYPASS_CAPTCHA="true", since no token is sent.
# Scope: build-time and runtime (inlined for the browser, and read by src/middleware.ts per request)
# Default: false
# PUBLIC_BYPASS_CAPTCHA="false"

# Turnstile secret key used by the frontend's own /api/verify.
# Scope: runtime (server route only; ignored by a static build)
# Default: "1x0000000000000000000000000000000AA" (Cloudflare's always-pass test key)
# PRIVATE_TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Send the client IP to Turnstile when verifying. Turn it off behind a proxy that hides the
# real client address, where the IP check would reject valid tokens.
# Scope: runtime (server route only)
# Default: true
# PRIVATE_TURNSTILE_CHECK_IP="true"

# Signs and verifies the JWTs issued by the frontend's /api/verify. Required in production:
# the schema gives it a default only when NODE_ENV is not "production", so a production build
# fails fast rather than shipping a public dev secret.
# Generate one with: openssl rand -base64 32
# Scope: runtime (server route and middleware)
# Default: a public development secret in dev builds; no default in production
# PRIVATE_JWT_SECRET=""

# Lifetime of tokens issued by the frontend's /api/verify, in seconds.
# Scope: runtime (server route only)
# Default: 3600
# PRIVATE_JWT_EXPIRATION_SECONDS="3600"

# A static token the middleware always accepts as an Authorization bearer token, compared in
# constant time. For load tests; leave it empty in production.
# Scope: runtime (middleware only; ignored by a static build)
# Default: "" (disabled)
# PRIVATE_TEST_JWT=""


# ---------------------------------------------------------------------------
# Share
# ---------------------------------------------------------------------------

# Show the sharing features in the UI. Cloudflare Worker: also needs the R2_BUCKET binding
# from wrangler.jsonc. Static build: also needs SHARE="true" and the S3_* values on the backend.
# Scope: build-time (inlined into the client bundle)
# Default: false
# PUBLIC_SHARE="false"

# Public URL of the storage holding shared code. The browser reads a share from
# "${PUBLIC_S3_BUCKET_URL}/${PUBLIC_S3_BUCKET_NAME}/share/<share id>".
# Scope: build-time (inlined into the client bundle)
# Default: "" (loading shared code is disabled)
# PUBLIC_S3_BUCKET_URL=""

# Bucket path segment inserted after PUBLIC_S3_BUCKET_URL, skipped when empty. Leave it empty
# when the URL already points at the bucket (an R2 public or custom domain); set it to the
# backend's S3_BUCKET_NAME for a path-style URL such as MinIO at "http://localhost:9000".
# Scope: build-time (inlined into the client bundle)
# Default: ""
# PUBLIC_S3_BUCKET_NAME=""


# ---------------------------------------------------------------------------
# Links and analytics
# ---------------------------------------------------------------------------

# Repository link shown in the header and on the landing page.
# Scope: build-time (inlined into the client bundle)
# Default: "https://github.com/Dong-Chen-1031/CPP-here"
# PUBLIC_GITHUB_LINK="https://github.com/Dong-Chen-1031/CPP-here"

# Status page link shown in the footer.
# Scope: build-time (inlined into the client bundle)
# Default: "https://status.doong.me/status/cpp-here"
# PUBLIC_STATUS_PAGE="https://status.doong.me/status/cpp-here"

# PostHog project token for browser analytics. It is inlined into the client bundle and so is
# visible to anyone who opens devtools — use a project token, never a personal API key.
# Scope: build-time (inlined into the client bundle)
# Default: "" (PostHog loads but sends nothing)
# PUBLIC_POSTHOG_PROJECT_TOKEN=""

# PostHog ingestion host.
# Scope: build-time (inlined into the client bundle)
# Default: "https://us.i.posthog.com"
# PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
