# Copy this file to frontend/.env. Every variable is optional; the commented value is the default
# unless the comment says otherwise. The schema lives in frontend/astro.config.mjs.
#
# There are two ways to run the frontend:
#   - Cloudflare Worker (`bun run build` / `bun run deploy`): /api/verify, /api/share and /api/build
#     are served by the frontend itself. /api/build is proxied to PRIVATE_BUILDER_NODE_ENDPOINT,
#     and shares are stored in the R2_BUCKET binding from wrangler.jsonc.
#   - Static site (`bun run build:static`, used by the Docker image): there are no server routes,
#     so set PUBLIC_API_URL to the Python backend, which implements the same /api/* endpoints.
# PUBLIC_* values are inlined into the client bundle at build time.


# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------

# PUBLIC_API_URL=""
# Base URL the browser uses for /api/verify, /api/build and /api/share.
# Leave empty to call the frontend's own server routes (Cloudflare Worker).
# For a static build, set it to the backend's public URL, e.g. "http://localhost:8000".
# Default: "" (same origin).

# PRIVATE_BUILDER_NODE_ENDPOINT="http://127.0.0.1:8000"
# Backend that the frontend's /api/build route proxies to (Cloudflare Worker only).
# Default: "http://127.0.0.1:8000".

# PRIVATE_BUILDER_NODE_KEY=""
# Bearer token the /api/build proxy sends to the builder node. The user's own token stops at
# the frontend middleware, so the node authenticates the frontend itself with this shared key.
# It must equal the backend's CAPTCHA_TEST_TOKEN (or the backend needs BYPASS_CAPTCHA="true").
# Generate one with: openssl rand -base64 32
# Default: "" (the builder node rejects the request unless it bypasses verification).

# PUBLIC_SKIP_API_FETCH="true"
# Set to "true" to skip API fetches for landing page stats data at build time.
# If your backend is not ready, you can set this to "true" during development.
# Default: "true".

# PUBLIC_BUILD_TIME_API_URL="http://127.0.0.1:8000"
# Backend URL used at build time to fetch landing page stats from "/api/status".
# If you are using Docker, set this to the Docker internal host (e.g. "http://backend:8000").
# Ignored when PUBLIC_SKIP_API_FETCH is "true".
# Default: "http://127.0.0.1:8000".


# ---------------------------------------------------------------------------
# Verification (Turnstile / JWT)
# ---------------------------------------------------------------------------

# PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000BB"
# Cloudflare Turnstile site key for CAPTCHA verification.
# Get a real site key from Cloudflare Turnstile dashboard for production use.
# Default: "1x00000000000000000000BB" (Always valid for development).

# PUBLIC_BYPASS_CAPTCHA="false"
# Set to "true" to skip Turnstile and token checks entirely. For local development only.
# When the requests go to the Python backend, it also needs BYPASS_CAPTCHA="true".
# Default: "false".

# PRIVATE_TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
# Turnstile secret key used by the frontend's /api/verify (Cloudflare Worker only).
# Default: "1x0000000000000000000000000000000AA" (Always valid for development).

# PRIVATE_TURNSTILE_CHECK_IP="true"
# Send the client IP to Turnstile when verifying (Cloudflare Worker only).
# Default: "true".

# PRIVATE_JWT_SECRET=""
# Secret used to sign and verify JWT tokens (Cloudflare Worker only).
# Required in production: without it, /api/verify and every token check fail at runtime.
# Generate one with: openssl rand -base64 32
# Default: a public development secret in dev, not set in production.

# PRIVATE_JWT_EXPIRATION_SECONDS="3600"
# Lifetime of issued JWT tokens, in seconds.
# Default: "3600".

# PRIVATE_TEST_JWT=""
# A static token that is always accepted as a valid Authorization bearer token (e.g. for load tests).
# Default: not set.


# ---------------------------------------------------------------------------
# Share
# ---------------------------------------------------------------------------

# PUBLIC_SHARE="false"
# Set to "true" to enable sharing features in the frontend.
# Cloudflare Worker: needs the R2_BUCKET binding. Static build: needs SHARE="true" on the backend.
# Default: "false".

# PUBLIC_S3_BUCKET_URL=""
# Public URL of the storage that holds shared code. Shared code is read from
# "${PUBLIC_S3_BUCKET_URL}/${PUBLIC_S3_BUCKET_NAME}/share/<share id>".
# Default: "" (loading shared code is disabled).

# PUBLIC_S3_BUCKET_NAME=""
# Bucket path segment inserted after PUBLIC_S3_BUCKET_URL (skipped when empty).
# Leave empty when the URL already points at the bucket (e.g. an R2 public / custom domain).
# Set it to the backend's S3_BUCKET_NAME for a path-style URL (e.g. MinIO at "http://localhost:9000").
# Default: "".


# ---------------------------------------------------------------------------
# Links and analytics
# ---------------------------------------------------------------------------

# PUBLIC_GITHUB_LINK="https://github.com/Dong-Chen-1031/CPP-here"
# Repository link shown in the header and landing page.

# PUBLIC_STATUS_PAGE="https://status.doong.me/status/cpp-here"
# Status page link shown in the footer.

# PUBLIC_POSTHOG_PROJECT_TOKEN=""
# PostHog project token for analytics.
# Default: "" (PostHog is loaded but sends nothing).

# PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
# PostHog ingestion host.
# Default: "https://us.i.posthog.com".
