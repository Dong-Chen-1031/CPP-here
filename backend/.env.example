# Copy this file to backend/.env. Every variable is optional; the value shown is the default
# unless the comment says otherwise. All settings live in backend/settings.py.


# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------

# Set to false for production deployment, true for local development.
# If DEV_MODE is false, it will stop auto reloading and turn off api docs (/docs, /redoc).
# Default: false
DEV_MODE="false"

# Port for the backend server to listen on.
# Default: 8000
PORT="8000"

# Python logging level as a number: 10 = DEBUG, 20 = INFO, 30 = WARNING, 40 = ERROR.
# Default: 20
# LOG_LEVEL="20"

# Service name reported in logs and PostHog.
# Default: "C++ Here Backend"
# SERVICE_NAME="C++ Here Backend"

# How wide your terminal is.
# This is used to format the output of the backend server logs to prevent line breaks in the middle of log lines when running in Docker Compose.
COLUMNS=160


# ---------------------------------------------------------------------------
# URLs
# ---------------------------------------------------------------------------

# Frontend URL. Used for CORS (see ALLOW_ORIGINS) and as the redirect target of "/".
# Default: "http://localhost:4321"
FRONTEND_URL="http://localhost:4321"

# Public URL of this backend, as seen by the browser.
# Build results return "${BACKEND_URL}/cache/<id>/build.wasm", which the browser downloads directly,
# so this must be reachable from the user's browser (not a Docker-internal hostname).
# Default: "http://localhost:8000"
BACKEND_URL="http://localhost:8000"

# JSON list of origins allowed by CORS.
# Default: FRONTEND_URL, plus the same URL with 127.0.0.1 replaced by localhost.
# ALLOW_ORIGINS='["http://localhost:4321"]'


# ---------------------------------------------------------------------------
# Verification (Turnstile / JWT)
# ---------------------------------------------------------------------------

# Cloudflare Turnstile secret key, used by POST /api/verify.
# Only needed when the frontend talks to this backend directly (PUBLIC_API_URL points here, e.g. Docker).
# Get a real secret key from Cloudflare Turnstile dashboard for production use.
# "1x0000000000000000000000000000000AA" always passes and is meant for development.
# Default: "" (verification always fails)
TURNSTILE_SECRET="1x0000000000000000000000000000000AA"

# A secure random string used for signing and verifying the JWT tokens issued by /api/verify.
# Generate one with: openssl rand -base64 32
# Default: not set (a random secret is generated on every start, which invalidates all issued tokens)
# JWT_SECRET=""

# Lifetime of tokens issued by POST /api/verify, in seconds.
# Default: 3600
# JWT_EXPIRY_SECONDS="3600"

# Set to "true" to skip token checks on /api/build and /api/share, which can be useful for local development and testing.
# Must be "true" whenever the frontend has PUBLIC_BYPASS_CAPTCHA="true" and talks to this backend directly,
# since the frontend then sends no token.
# In production, this should be set to "false" to ensure security.
# Default: false
BYPASS_CAPTCHA="false"

# A static token that is always accepted as a valid Authorization bearer token.
# This is how the frontend's /api/build proxy authenticates when this backend is its builder node:
# set it to the same value as the frontend's PRIVATE_BUILDER_NODE_KEY. Also useful for load tests.
# Default: not set
CAPTCHA_TEST_TOKEN=""


# ---------------------------------------------------------------------------
# Build workers and cache
# ---------------------------------------------------------------------------

# Number of idle build worker containers kept warm.
# Default: 15
# DOCKER_POOL_SIZE="15"

# Seconds a build worker container lives before killing itself.
# This is the backstop for ungraceful shutdowns (SIGKILL / OOM / host reboot):
# workers left behind by a dead backend disappear on their own within this window.
# Default: 1800
# DOCKER_WORKER_TTL="1800"

# Delete leftover workers from a previous run when the backend starts.
# Set to false if several backends share one Docker daemon, since the sweep
# cannot tell a dead instance's workers from a live sibling's.
# Default: true
# DOCKER_ORPHAN_SWEEP="true"

# Directory (relative to the backend working directory) that stores build outputs and the cache database.
# It is also served as "/<CACHE_PATH>/...", which is where BACKEND_URL wasm links point.
# Default: "cache"
# CACHE_PATH="cache"

# Absolute path of CACHE_PATH on the Docker host. Build workers are sibling containers,
# so they mount this host path. Only needs to be set when the backend itself runs in Docker.
# Default: absolute path of CACHE_PATH
# HOST_CACHE_PATH=""

# Maximum number of cached builds before the oldest are deleted.
# Default: 100
# CACHE_LIMIT="100"

# Seconds before a cached build expires.
# Default: 604800 (7 days)
# CACHE_EXPIRY="604800"

# SQLAlchemy URL of the cache database.
# Default: "sqlite+aiosqlite:///<CACHE_PATH>/cache.db"
# CACHE_SQLITE_PATH=""


# ---------------------------------------------------------------------------
# Share
# ---------------------------------------------------------------------------

# Whether to enable POST /api/share. If true, users can share their code and results with others via a unique URL.
# This requires additional storage and may have security implications, so it's disabled by default.
# It stays disabled unless all four S3_* values below are set.
# The frontend also needs PUBLIC_SHARE="true" and PUBLIC_S3_BUCKET_URL / PUBLIC_S3_BUCKET_NAME.
# Default: false
SHARE="false"

# S3-compatible storage used by the share feature. You can use services like AWS S3, Cloudflare R2, DigitalOcean Spaces, or MinIO.
# Shared objects are stored at "<S3_BUCKET_NAME>/share/<share id>" and must be publicly readable.
S3_ENDPOINT_URL=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME=""


# ---------------------------------------------------------------------------
# PostHog (optional)
# ---------------------------------------------------------------------------

# PostHog project API key. When set, logs and exceptions are sent to PostHog.
# Default: not set (disabled)
# POSTHOG_API_KEY=""

# PostHog ingestion host.
# Default: "https://us.i.posthog.com"
# POSTHOG_BASE_URL="https://us.i.posthog.com"


# ---------------------------------------------------------------------------
# Center Console (optional)
# ---------------------------------------------------------------------------

# Fetch settings from a Center Console at startup. Values it returns override env / .env.
# Only enabled when ENABLE_CENTER_CONSOLE="true" and both CENTER_URL and CENTER_TOKEN are set.
# Default: disabled
# ENABLE_CENTER_CONSOLE="false"
# CENTER_URL=""
# CENTER_TOKEN=""

# Timeout in seconds for the Center Console request (startup blocks on it).
# Default: 3.0
# CENTER_CONSOLE_TIMEOUT="3.0"
