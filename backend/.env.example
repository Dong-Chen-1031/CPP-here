# Copy this file to backend/.env. Every variable is optional; the commented value is the
# default unless the comment says otherwise, so an uncommented line means "changed on purpose".
# All settings are defined in backend/settings.py.
# Last synced 2026-09-21 at commit 0f82c44


# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------

# Set to true for local development. When false, auto-reload stops and the API
# docs (/docs, /redoc) are turned off.
# Default: false
# DEV_MODE="false"

# Port the backend server listens on inside its own host or container.
# Default: 8000
# PORT="8000"

# Python logging level as a number: 10 = DEBUG, 20 = INFO, 30 = WARNING, 40 = ERROR.
# Default: 20
# LOG_LEVEL="20"

# Service name reported in logs and PostHog.
# Default: "C++ Here Backend"
# SERVICE_NAME="C++ Here Backend"

# Terminal width rich formats log output for. Set it when the process has no real
# TTY (Docker Compose, CI), or long log lines wrap in the middle.
# Default: not set (detected from the terminal, 80 when there is none)
# COLUMNS="160"

# Set to "true" to skip the ASCII banner printed at startup.
# Default: not set (the banner is printed)
# NO_LOGO="true"


# ---------------------------------------------------------------------------
# URLs
# ---------------------------------------------------------------------------

# Frontend URL. Used for CORS (see ALLOW_ORIGINS) and as the redirect target of "/".
# Must match the URL the browser actually opens the frontend at, or CORS blocks it.
# Default: "http://localhost:4321"
# FRONTEND_URL="http://localhost:4321"

# Public URL of this backend, as seen by the browser. Build results return
# "${BACKEND_URL}/cache/<id>/build.wasm", which the browser downloads directly, so this
# must be reachable from the user's browser — never a Docker-internal hostname.
# Default: "http://localhost:8000"
# BACKEND_URL="http://localhost:8000"

# JSON list of origins allowed by CORS. Set it only when the frontend is reachable
# at more than one origin.
# Default: FRONTEND_URL, plus the same URL with 127.0.0.1 replaced by localhost
# ALLOW_ORIGINS='["http://localhost:4321"]'


# ---------------------------------------------------------------------------
# Verification (Turnstile / JWT)
# ---------------------------------------------------------------------------

# Cloudflare Turnstile secret key, used by POST /api/verify. Only needed when the
# frontend talks to this backend directly (PUBLIC_API_URL points here, e.g. Docker).
# Must pair with the frontend's PUBLIC_TURNSTILE_SITE_KEY.
# Replace it in production: the default accepts any token, so the CAPTCHA protects nothing.
# Default: "1x0000000000000000000000000000000AA" (Cloudflare's always-pass test key)
# TURNSTILE_SECRET="1x0000000000000000000000000000000AA"

# Signs and verifies the JWTs issued by /api/verify.
# Generate one with: openssl rand -base64 32
# Default: not set (a random secret is generated on every start, which invalidates all issued tokens)
# JWT_SECRET=""

# Lifetime of tokens issued by POST /api/verify, in seconds.
# Default: 3600
# JWT_EXPIRY_SECONDS="3600"

# Skip token checks on /api/build and /api/share. For local development and testing only.
# Must be "true" whenever the frontend has PUBLIC_BYPASS_CAPTCHA="true" and talks to this
# backend directly, since the frontend then sends no token.
# Default: false
# BYPASS_CAPTCHA="false"

# A static token that is always accepted as an Authorization bearer token. This is how the
# frontend's /api/build proxy authenticates when this backend is its builder node: set it to
# the same value as the frontend's PRIVATE_BUILDER_NODE_KEY. Also useful for load tests.
# Default: not set
# CAPTCHA_TEST_TOKEN=""


# ---------------------------------------------------------------------------
# Build workers and cache
# ---------------------------------------------------------------------------

# Number of idle build worker containers kept warm. Raising it trades memory for
# latency on the first build after an idle period.
# Default: 15
# DOCKER_POOL_SIZE="15"

# Seconds a build worker container lives before killing itself. This is the backstop for
# ungraceful shutdowns (SIGKILL / OOM / host reboot): workers left behind by a dead backend
# disappear on their own within this window.
# Default: 1800
# DOCKER_WORKER_TTL="1800"

# Delete leftover workers from a previous run when the backend starts. Set to false if
# several backends share one Docker daemon, since the sweep cannot tell a dead instance's
# workers from a live sibling's.
# Default: true
# DOCKER_ORPHAN_SWEEP="true"

# Directory (relative to the backend working directory) holding build outputs and the cache
# database. It is also served as "/<CACHE_PATH>/...", which is where BACKEND_URL wasm links point.
# Default: "cache"
# CACHE_PATH="cache"

# Absolute path of CACHE_PATH on the Docker host. Build workers are sibling containers, so
# they mount this host path rather than the in-container one. Only needed when the backend
# itself runs in Docker.
# Default: absolute path of CACHE_PATH
# HOST_CACHE_PATH=""

# Maximum number of cached builds before the oldest are deleted.
# Default: 100
# CACHE_LIMIT="100"

# Seconds before a cached build expires.
# Default: 604800 (7 days)
# CACHE_EXPIRY="604800"

# SQLAlchemy URL of the cache database.
# Default: "sqlite+aiosqlite:///<CACHE_PATH>/cache.db"
# CACHE_SQLITE_PATH=""


# ---------------------------------------------------------------------------
# Share (optional)
# ---------------------------------------------------------------------------

# Enables POST /api/share, which lets users share code and build results via a URL.
# It stays off unless all four S3_* values below are set.
# The frontend also needs PUBLIC_SHARE="true" plus PUBLIC_S3_BUCKET_URL / PUBLIC_S3_BUCKET_NAME.
# Default: false
# SHARE="false"

# S3-compatible storage for shared code (AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO, ...).
# Objects land at "<S3_BUCKET_NAME>/share/<share id>" and must be publicly readable.
# Required when SHARE="true".
# Default: "" (share stays disabled)
# S3_ENDPOINT_URL=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_BUCKET_NAME=""


# ---------------------------------------------------------------------------
# PostHog (optional)
# ---------------------------------------------------------------------------

# PostHog project API key. When set, logs and exceptions are sent to PostHog.
# Default: not set (disabled)
# POSTHOG_API_KEY=""

# PostHog ingestion host.
# Default: "https://us.i.posthog.com"
# POSTHOG_BASE_URL="https://us.i.posthog.com"


# ---------------------------------------------------------------------------
# Center Console (optional)
# ---------------------------------------------------------------------------

# Fetch settings from a Center Console at startup; what it returns overrides env and .env.
# Only turns on when this is exactly "true" AND both CENTER_URL and CENTER_TOKEN are set.
# Default: disabled
# ENABLE_CENTER_CONSOLE="false"
# CENTER_URL=""
# CENTER_TOKEN=""

# Timeout in seconds for the Center Console request. Startup and every reload block on it,
# so keep it short.
# Default: 3.0
# CENTER_CONSOLE_TIMEOUT="3.0"
